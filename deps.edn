{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        com.cnuernber/charred {:mvn/version "1.034"}
        org.yamlstar/yamlstar {:mvn/version "0.1.17"}}

 :aliases
 {;; Run the app: clojure -M:run
  :run {:main-opts ["-m" "genegraph.schema"]}

  ;; REPL-driven development: clojure -M:dev
  :dev {:extra-paths ["dev" "test"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                     djblue/portal {:mvn/version "0.67.1"}}
        :main-opts ["-m" "nrepl.cmdline"]}

  ;; Run tests: clojure -M:test
  ;; titanium-json-ld is a real JSON-LD processor, used to check that the
  ;; generated frame frames an RDF graph the way the schema says it should.
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      com.apicatalog/titanium-json-ld {:mvn/version "1.7.0"}
                      org.glassfish/jakarta.json {:mvn/version "2.0.1"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; Build an uberjar: clojure -T:build uber
  :build {:deps {io.github.clojure/tools.build
                 {:mvn/version "0.10.6"}}
          :ns-default build}}}
